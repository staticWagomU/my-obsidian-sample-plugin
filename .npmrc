tag-version-prefix=""

# TAKUMI GUARD (Flatt Security) 経由でパッケージを取得する。
# ${TAKUMI_GUARD_TOKEN} は「シェルの環境変数」から展開される。.env に書くだけでは
# pnpm には届かないため、direnv (.envrc の dotenv_if_exists) でシェルへ読み込ませる。
# CI では GitHub Secrets から同名の環境変数を渡している。
registry=https://npm.flatt.tech/
//npm.flatt.tech/:_authToken=${TAKUMI_GUARD_TOKEN}
