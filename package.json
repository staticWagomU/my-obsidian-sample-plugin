{
	"name": "obsidian-sample-plugin",
	"version": "1.0.0",
	"description": "This is a sample plugin for Obsidian (https://obsidian.md)",
	"main": "main.js",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@10.26.0",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "vite build --watch --mode development",
		"build": "tsc -noEmit -skipLibCheck && vite build --mode production",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "oxlint && eslint .",
		"lint:oxlint": "oxlint",
		"lint:eslint": "eslint .",
		"lint:fix": "oxlint --fix && eslint . --fix",
		"format": "oxfmt --write src/",
		"format:check": "oxfmt src/",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"validate": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm build",
		"setup:dev": "bash scripts/setup-dev.sh",
		"clean": "rm -f main.js main.js.map"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "^26.4.0",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.9.1",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.11.0",
		"jiti": "2.7.0",
		"lefthook": "^2.1.10",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"tslib": "2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
