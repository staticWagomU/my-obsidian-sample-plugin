# Token for TAKUMI GUARD (Flatt Security) secure npm registry.
# Required for `pnpm install` — .npmrc routes all package downloads through
# https://npm.flatt.tech/ and authenticates with this token.
# Obtain the token from a project maintainer.
TAKUMI_GUARD_TOKEN=

# Path to your Obsidian vault's plugin directory
# Example: /Users/yourname/Documents/MyVault/.obsidian/plugins/obsidian-sample-plugin
#
# When set, `pnpm dev` outputs main.js directly to your vault for immediate testing.
# The production build (`pnpm build`) always outputs to the project root regardless of this setting.
OBSIDIAN_PLUGIN_DIR=
